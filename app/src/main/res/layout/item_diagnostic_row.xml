<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/lblDiagnostic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Label"
        android:fontFamily="monospace"
        android:letterSpacing="0.02"
        android:textAllCaps="true"
        android:textColor="@color/asr_text_secondary"
        android:textSize="10sp" />

    <View
        android:id="@+id/diagnosticIndicator"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:background="#737373"
        android:visibility="gone" />

    <TextView
        android:id="@+id/valDiagnostic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Value"
        android:fontFamily="@font/space_mono"
        android:textColor="@color/asr_text_primary"
        android:textSize="12sp" />
</LinearLayout>
