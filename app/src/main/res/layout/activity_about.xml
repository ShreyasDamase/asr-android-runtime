<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnAboutBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="‹  BACK"
            android:textColor="#737373"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="ASR Runtime"
            android:textColor="#000000"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtAboutSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="ROBOT SENSOR NODE"
            android:textColor="#737373"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtAboutDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/space_grotesk"
            android:text="Connect an Android phone to a ROS 2 robot as a configurable sensor node."
            android:textColor="#333333"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/cardAboutBuild"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="BUILD"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/space_mono"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtAboutBackend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/space_mono"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAboutData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="SENSOR DATA"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Only selected sensor groups publish while ASR Runtime is running. Data is sent through the transport paths you enable: ROS 2 DDS or TCP to ASR Studio. Camera, microphone, and location access require Android permission."
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAboutOpenSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="OPEN SOURCE"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/space_grotesk"
                android:text="ASR Runtime is distributed under the MIT License. Third-party notices cover bundled ROS 2, DDS, and Android libraries."
                android:textColor="#333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAboutSource"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="SOURCE, LICENSE &amp; NOTICES"
                android:textColor="#000000"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
