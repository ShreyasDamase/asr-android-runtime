<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnAboutBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="‹  BACK"
            android:textColor="#737373"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="ASR Runtime"
            android:textColor="#000000"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtAboutSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="ROBOT SENSOR NODE"
            android:textColor="#737373"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtAboutDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/space_grotesk"
            android:text="Connect an Android phone to a ROS 2 robot as a configurable sensor node."
            android:textColor="#333333"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/cardAboutBuild"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="BUILD"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/space_mono"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtAboutBackend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/space_mono"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAboutData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="SENSOR DATA"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Only selected sensor groups publish while ASR Runtime is running. Data goes directly to the ROS 2 peers or ASR Studio endpoint you configure; ASR does not operate a cloud relay or receive these streams. Connections are intended for your local robotics setup, though your network route can carry traffic beyond it. Current DDS and TCP transports are not encrypted. Camera, microphone, and location require Android permission."
                android:textColor="#333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAboutPrivacy"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="PRIVACY POLICY"
                android:textColor="#000000"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAboutOpenSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="OPEN SOURCE"
                android:textColor="#737373"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/space_grotesk"
                android:text="ASR Runtime is distributed under the MIT License. Third-party notices cover bundled ROS 2, DDS, and Android libraries."
                android:textColor="#333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAboutWebsite"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="ASR PLATFORM WEBSITE"
                android:textColor="#000000"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnAboutSource"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="SOURCE, LICENSE &amp; NOTICES"
                android:textColor="#000000"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAboutDeveloper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/runtime_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="ABOUT THE DEVELOPER"
                android:textColor="#737373"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/imgDeveloperPhoto"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Illustration of Shreyas by the sea"
                android:scaleType="centerCrop"
                android:src="@drawable/developer_photo" />

            <TextView
                android:id="@+id/txtAboutDeveloper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/space_grotesk"
                android:text="I'm Shreyas, the independent developer behind ASR. I build open-source tools that connect Android engineering with ROS 2 and robotics."
                android:textColor="#333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAboutDeveloper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="DEVELOPER PROFILE  ↗"
                android:textColor="#000000"
                android:textSize="11sp" />
        </LinearLayout>

        <!--
            Disabled for the current Play-distributed build pending payments-policy review.
            Keep this section as a reference; restore it only after confirming the current policy.
