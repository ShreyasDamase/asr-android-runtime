<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════════════════════════════════════════════
             HEADER — PRIMARY layer (Nothing Aesthetic)
             ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="ASR app mark"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASR Android"
                android:fontFamily="sans-serif-medium"
                android:textColor="#000000"
                android:textSize="27sp"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/txtAppBackend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROBOT SENSOR NODE · CYCLONE DDS"
                android:fontFamily="monospace"
                android:textColor="#999999"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnThemeToggle"
                android:layout_width="82dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_outline_nothing"
                android:clickable="true"
                android:contentDescription="Theme mode is System. Tap to cycle themes."
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="SYSTEM"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <include
            android:id="@+id/runtimeCard"
            layout="@layout/card_runtime" />

        <!-- ROS 2 / DDS is the primary project connection; keep it above TCP. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/cardRos2Dds"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROS 2 · DDS"
                android:fontFamily="@font/space_grotesk"
                android:fontVariationSettings="'wght' 600"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/asr_text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose network paths independently; sensor data flows while runtime is on"
                android:fontFamily="@font/space_grotesk"
                android:textSize="12sp"
                android:textColor="@color/asr_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WI-FI DDS"
                    android:fontFamily="@font/space_mono"
                    android:letterSpacing="0.04"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748" />
                <org.asr.runtime.ui.SquareSlideSwitch
                    android:id="@+id/switchDdsWifi"
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:contentDescription="Enable DDS over Wi-Fi" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB DDS"
                    android:fontFamily="@font/space_mono"
                    android:letterSpacing="0.04"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748" />
                <org.asr.runtime.ui.SquareSlideSwitch
                    android:id="@+id/switchDdsUsb"
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:contentDescription="Enable DDS over USB tethering" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtDdsPathStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DDS network paths are disabled"
                android:fontFamily="@font/space_grotesk"
                android:textSize="11sp"
                android:textColor="@color/asr_text_secondary" />
            <TextView
                android:id="@+id/txtUsbTetheringWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="USB tethering is off. Enable it here before using USB DDS."
                android:textColor="#8A641A"
                android:fontFamily="@font/space_grotesk"
                android:textSize="12sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnUsbTetheringSettings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="12sp"
                android:text="OPEN USB TETHERING SETTINGS"
                android:fontFamily="@font/space_mono"
                android:letterSpacing="0.04"
                android:contentDescription="Open Android USB tethering settings"
                android:visibility="gone" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISCOVERY STATUS"
                    android:fontFamily="@font/space_mono"
                    android:letterSpacing="0.06"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtRos2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISABLED"
                    android:fontFamily="@font/space_mono"
                    android:letterSpacing="0.03"
                    android:textSize="12sp"
                    android:textColor="#718096"
                    android:textStyle="bold" />
            </LinearLayout>
            <org.asr.runtime.ui.SegmentedBarView
                    android:id="@+id/progressRos2"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:contentDescription="ROS 2 discovery in progress" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ROS 2 discovery status is shown separately from TCP."
                android:fontFamily="@font/space_grotesk"
                android:textSize="12sp"
                android:textColor="@color/asr_text_secondary" />
        </LinearLayout>

        <!-- TCP transport controls for ASR Studio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/cardTcpTransport"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP · ASR Studio"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="@color/asr_text_primary"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/txtTransportMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_outline_nothing"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="ADB"
                    android:textColor="#4A5568"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <org.asr.runtime.ui.SquareSlideSwitch
                    android:id="@+id/switchTcpEnabled"
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:contentDescription="Enable TCP connection to ASR Studio" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP link"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtTcpStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textSize="12sp"
                    android:textColor="#718096"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Host IP row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Host"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTransportHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="192.168.x.x  (or 127.0.0.1 for ADB)"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="#1A202C"
                    android:textColorHint="#718096"
                    android:padding="10dp"
                    android:background="@drawable/input_underline_nothing"/>
            </LinearLayout>

            <!-- Port row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTransportPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="4242"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="#1A202C"
                    android:textColorHint="#718096"
                    android:padding="10dp"
                    android:background="@drawable/input_underline_nothing"/>
            </LinearLayout>

            <!-- ADB hint -->
            <TextView
                android:id="@+id/txtAdbHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADB mode: run  adb reverse tcp:4242 tcp:4242  then use 127.0.0.1"
                android:textSize="11sp"
                android:textColor="#4A5568"
                android:fontFamily="monospace"
                android:background="#EDF2F7"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnConnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="CONNECT"
                    android:textColor="@color/btn_outline_text_nothing"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/btn_outline_nothing"
                    android:stateListAnimator="@null"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginEnd="2dp" />
                <Button
                    android:id="@+id/btnDisconnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="DISCONNECT"
                    android:textColor="@color/btn_outline_text_nothing"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/btn_outline_nothing"
                    android:stateListAnimator="@null"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />
                <Button
                    android:id="@+id/btnReconnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="RECONNECT"
                    android:textColor="@color/btn_outline_text_nothing"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/btn_outline_nothing"
                    android:stateListAnimator="@null"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnDetailsToggle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline_nothing"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="⌄  SHOW DEVICE DETAILS &amp; DIAGNOSTICS"
            android:textColor="@color/btn_outline_text_nothing"
            android:textSize="11sp" />

        <!-- Less frequently used information stays available but out of the main view. -->
        <LinearLayout
            android:id="@+id/layoutAdvancedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Connected Client Card -->
        <LinearLayout
            android:id="@+id/cardConnectedClientDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTED CLIENT"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/asr_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/layoutClientInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientStatus"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientApp"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientHost"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientSince"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Permissions Table (Restored) -->
        <LinearLayout
            android:id="@+id/cardPermissionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/asr_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <TableLayout
                android:id="@+id/permissionTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:background="@android:color/transparent">
                <TableRow android:background="@android:color/transparent">
                    <TextView android:text="PERMISSION" android:padding="8dp" android:fontFamily="monospace" android:letterSpacing="0.03" android:textSize="10sp" android:textColor="@color/asr_text_secondary"/>
                    <TextView android:text="ACCESS" android:padding="8dp" android:fontFamily="monospace" android:letterSpacing="0.03" android:textSize="10sp" android:textColor="@color/asr_text_secondary" android:gravity="center"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Hardware / Sensor Table (Restored) -->
        <LinearLayout
            android:id="@+id/cardHardwareDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARDWARE / SENSORS"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/asr_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <TableLayout
                android:id="@+id/hardwareTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:background="@android:color/transparent">
                <TableRow android:background="@android:color/transparent">
                    <TextView android:text="DEVICE" android:padding="8dp" android:fontFamily="monospace" android:letterSpacing="0.03" android:textSize="10sp" android:textColor="@color/asr_text_secondary"/>
                    <TextView android:text="PRESENT" android:padding="8dp" android:fontFamily="monospace" android:letterSpacing="0.03" android:textSize="10sp" android:textColor="@color/asr_text_secondary" android:gravity="center"/>
                    <TextView android:text="STATE" android:padding="8dp" android:fontFamily="monospace" android:letterSpacing="0.03" android:textSize="10sp" android:textColor="@color/asr_text_secondary" android:gravity="center"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Diagnostics Card -->
        <LinearLayout
            android:id="@+id/cardDiagnosticsDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/runtime_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTICS"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/asr_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowPacketsSent"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowPacketsReceived"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowQueueDepth"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowDropped"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowReconnects"/>
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_outline_nothing"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="ABOUT ASR RUNTIME"
            android:textColor="@color/btn_outline_text_nothing"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

</FrameLayout>
