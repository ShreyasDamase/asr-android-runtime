<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASR Android"
                    android:textColor="#1A202C"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Robot sensor node"
                    android:textColor="#718096"
                    android:textSize="13sp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="EXIT"
                android:contentDescription="Exit ASR Android" />
        </LinearLayout>

        <!-- Runtime Control Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Runtime"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                    <TextView
                        android:id="@+id/txtRuntimeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● STOPPED"
                        android:textColor="#A0AEC0"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Phone sensors only. TCP and DDS states are shown separately below."
                    android:textSize="12sp"
                    android:textColor="#718096" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnStartRuntime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="START"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:layout_marginEnd="4dp" />
                    <Button
                        android:id="@+id/btnStopRuntime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STOP"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btnRestartRuntime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="RESTART"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TCP transport controls for ASR Studio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP · ASR Studio"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
                <Switch
                    android:id="@+id/switchTcpEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Enable TCP connection to ASR Studio" />
                <TextView
                    android:id="@+id/txtTransportMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi"
                    android:textSize="12sp"
                    android:textColor="#3182CE"
                    android:textStyle="bold"
                    android:background="#EBF8FF"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP link"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtTcpStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textSize="12sp"
                    android:textColor="#718096"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Host IP row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Host"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTransportHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="192.168.x.x  (or 127.0.0.1 for ADB)"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="#1A202C"
                    android:textColorHint="#718096"
                    android:padding="10dp"
                    android:background="#EDF2F7"/>
            </LinearLayout>

            <!-- Port row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTransportPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="4242"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="#1A202C"
                    android:textColorHint="#718096"
                    android:padding="10dp"
                    android:background="#EDF2F7"/>
            </LinearLayout>

            <!-- ADB hint -->
            <TextView
                android:id="@+id/txtAdbHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADB mode: run  adb reverse tcp:4242 tcp:4242  then use 127.0.0.1"
                android:textSize="11sp"
                android:textColor="#4A5568"
                android:fontFamily="monospace"
                android:background="#EDF2F7"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnConnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginEnd="2dp" />
                <Button
                    android:id="@+id/btnDisconnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISCONNECT"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />
                <Button
                    android:id="@+id/btnReconnectTransport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECONNECT"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROS 2 / DDS status is independent from the TCP card above. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROS 2 · DDS"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A202C" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose network paths independently; sensor data flows while runtime is on"
                android:textSize="12sp"
                android:textColor="#718096" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wi-Fi DDS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748" />
                <Switch
                    android:id="@+id/switchDdsWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Enable DDS over Wi-Fi" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB DDS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748" />
                <Switch
                    android:id="@+id/switchDdsUsb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Enable DDS over USB tethering" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtDdsPathStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DDS network paths are disabled"
                android:textSize="11sp"
                android:textColor="#718096" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Discovery status"
                    android:textSize="13sp"
                    android:textColor="#2D3748"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtRos2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISABLED"
                    android:textSize="12sp"
                    android:textColor="#718096"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/progressRos2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:indeterminate="true"
                    style="?android:attr/progressBarStyleSmall" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ROS 2 discovery status is shown separately from TCP."
                android:textSize="12sp"
                android:textColor="#718096" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDetailsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Show device details and diagnostics" />

        <!-- Less frequently used information stays available but out of the main view. -->
        <LinearLayout
            android:id="@+id/layoutAdvancedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Connected Client Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected Client"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/layoutClientInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientStatus"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientApp"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientHost"/>
                <include layout="@layout/item_diagnostic_row" android:id="@+id/rowClientSince"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Permissions Table (Restored) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permissions"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TableLayout
                android:id="@+id/permissionTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:background="#F7FAFC">
                <TableRow android:background="#EDF2F7">
                    <TextView android:text="Permission" android:padding="8dp" android:textStyle="bold" android:textSize="12sp" android:textColor="#4A5568"/>
                    <TextView android:text="Status" android:padding="8dp" android:textStyle="bold" android:textSize="12sp" android:textColor="#4A5568" android:gravity="center"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Hardware / Sensor Table (Restored) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hardware / Sensors"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TableLayout
                android:id="@+id/hardwareTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:background="#F7FAFC">
                <TableRow android:background="#EDF2F7">
                    <TextView android:text="Hardware" android:padding="8dp" android:textStyle="bold" android:textSize="12sp" android:textColor="#4A5568"/>
                    <TextView android:text="Present" android:padding="8dp" android:textStyle="bold" android:textSize="12sp" android:textColor="#4A5568" android:gravity="center"/>
                    <TextView android:text="Status" android:padding="8dp" android:textStyle="bold" android:textSize="12sp" android:textColor="#4A5568" android:gravity="center"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Diagnostics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowPacketsSent"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowPacketsReceived"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowQueueDepth"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowDropped"/>
            <include layout="@layout/item_diagnostic_row" android:id="@+id/rowReconnects"/>
        </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
