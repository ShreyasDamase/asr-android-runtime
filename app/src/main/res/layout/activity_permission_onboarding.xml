<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ═══ Scrollable content area ═══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <!-- Tertiary brand label — monospace ALL CAPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASR ANDROID"
                android:fontFamily="@font/space_mono"
                android:textColor="#999999"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp" />

            <!-- Hero headline — primary display layer, large monospace -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR ACCESS"
                android:fontFamily="@font/doto"
                android:textColor="#000000"
                android:textSize="38sp"
                android:letterSpacing="-0.01"
                android:layout_marginBottom="20dp" />

            <!-- Description — secondary body, sans-serif -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose the sensor modules you need in Runtime. Android will ask for each permission only when you enable a module that needs it. Sensor data is sent through the ROS 2 DDS or TCP connection you configure."
                android:fontFamily="@font/space_grotesk"
                android:textColor="#666666"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="40dp" />

            <!-- Top divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8" />

            <!-- Permission rows injected here programmatically -->
            <LinearLayout
                android:id="@+id/layoutPermissionRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Bottom divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginBottom="32dp" />

            <!-- Footnote — tertiary metadata -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SENSOR PERMISSIONS ARE REQUESTED WHEN NEEDED"
                android:fontFamily="@font/space_mono"
                android:textColor="#CCCCCC"
                android:textSize="9sp"
                android:letterSpacing="0.06"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

    <!-- ═══ Sticky bottom CTA — outside scroll ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="36dp"
        android:elevation="4dp">

        <!-- Top rule above buttons -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8"
            android:layout_marginBottom="16dp" />

        <!-- Primary CTA: solid black, technical corners -->
        <TextView
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="CONTINUE TO RUNTIME"
            android:fontFamily="@font/space_mono"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:background="@drawable/btn_primary_nothing"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"
            android:contentDescription="Continue to runtime without requesting optional sensor permissions" />

        <!-- Ghost skip button -->
        <TextView
            android:id="@+id/btnSkipOnboarding"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="DATA USE DETAILS"
            android:fontFamily="@font/space_mono"
            android:textColor="#999999"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open data use details" />
    </LinearLayout>

</LinearLayout>
