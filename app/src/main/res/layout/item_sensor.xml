<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/asr_divider"
    app:cardBackgroundColor="@color/asr_card_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Collapsed row: this is ALL the operator needs at a glance -->
        <LinearLayout
            android:id="@+id/rowCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                tools:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textColor="@color/asr_text_primary"
                tools:text="Camera" />

            <TextView
                android:id="@+id/tvRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/asr_text_secondary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="28.4 Hz" />

            <!-- Combined status dot: worst-of(hardware, runtime, ros) so a
                 glance tells you if this row needs attention at all -->
            <org.asr.runtime.ui.StatusIndicatorView
                android:id="@+id/statusCombined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/arrow_down_float"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <View
            android:id="@+id/dividerExpand"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/asr_divider"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/rowCollapsed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Expanded detail: the 4-state model, per section 9 of the design doc -->
        <LinearLayout
            android:id="@+id/groupExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/dividerExpand"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hardware"
                    android:textSize="13sp"
                    android:textColor="@color/asr_text_secondary" />
                <org.asr.runtime.ui.StatusIndicatorView
                    android:id="@+id/statusHardware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Runtime"
                    android:textSize="13sp"
                    android:textColor="@color/asr_text_secondary" />
                <org.asr.runtime.ui.StatusIndicatorView
                    android:id="@+id/statusSensorRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ROS"
                    android:textSize="13sp"
                    android:textColor="@color/asr_text_secondary" />
                <org.asr.runtime.ui.StatusIndicatorView
                    android:id="@+id/statusSensorRos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Control source: badge, not a toggle. Never a button the local
                 operator can flip when REMOTE — see note below the layout. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Control"
                    android:textSize="13sp"
                    android:textColor="@color/asr_text_secondary" />
                <TextView
                    android:id="@+id/tvControlBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_control_badge"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="LOCAL"
                    tools:textColor="@color/asr_control_local" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/asr_control_bg"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/asr_text_secondary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="/asr_android_7f21/camera/compressed" />

            <!--
              Local START/STOP for this sensor. DISABLED (not hidden) when
              Control == REMOTE, so the operator sees the control exists but
              understands why they can't press it right now.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSensorStart"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:textSize="12sp"
                    android:text="START" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSensorStop"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="STOP" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
