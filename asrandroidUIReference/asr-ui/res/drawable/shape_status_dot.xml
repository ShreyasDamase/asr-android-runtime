<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain oval. Color is NOT set here — StatusIndicatorView tints this
  drawable at runtime via setTint(), so one shape serves every state
  (running/stopped/error/publishing/etc). Don't hardcode a color here.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/white" />
    <size android:width="10dp" android:height="10dp" />
</shape>
